# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/release/

# standalone Graaly runtime build/test state
/runtime/target/
/runtime/.matrix-work/
/runtime/.packetevents-work/
/runtime/.graal-runtime-cache/
/runtime/reports/runtime/
/runtime/reports/compatibility/*-result.json
/runtime/**/node_modules/
/playwright-report/
/test-results/
/runtime/**/dist/
# Keep the compiled educational C fixture available to clean clones and CI.
!/runtime/examples/EducationalC.cplugin/dist/
!/runtime/examples/EducationalC.cplugin/dist/plugin.wasm
!/runtime/examples/MatrixC.cplugin/dist/
!/runtime/examples/MatrixC.cplugin/dist/plugin.wasm
!/runtime/examples/PacketEventsC.cplugin/dist/
!/runtime/examples/PacketEventsC.cplugin/dist/plugin.wasm
/runtime/**/.venv/
/runtime/**/*.egg-info/
/runtime/**/.pytest_cache/
/runtime/**/*.db
/runtime/**/*.log
/runtime/**/*.pyc
/runtime/**/__pycache__/
/runtime/examples/PortingSurfaceJavaScript/
/runtime/examples/PortingSurfacePython/
/runtime/examples/PortingSurfaceTypeScript/
