{
  "components": {
    "schemas": {
      "ActorResponse": {
        "properties": {
          "permissions": {
            "items": {
              "enum": [
                "profile.read",
                "shop.purchase",
                "realtime.connect",
                "permissions.read",
                "permissions.manage"
              ],
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "player_id": {
            "title": "Player Id",
            "type": "string"
          },
          "player_name": {
            "title": "Player Name",
            "type": "string"
          },
          "roles": {
            "items": {
              "enum": [
                "member",
                "moderator",
                "admin"
              ],
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "player_id",
          "player_name",
          "roles",
          "permissions"
        ],
        "title": "ActorResponse",
        "type": "object"
      },
      "AuthorizationResponse": {
        "properties": {
          "permissions": {
            "items": {
              "enum": [
                "profile.read",
                "shop.purchase",
                "realtime.connect",
                "permissions.read",
                "permissions.manage"
              ],
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "player_id": {
            "title": "Player Id",
            "type": "string"
          },
          "player_name": {
            "title": "Player Name",
            "type": "string"
          },
          "roles": {
            "items": {
              "enum": [
                "member",
                "moderator",
                "admin"
              ],
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "player_id",
          "player_name",
          "roles",
          "permissions"
        ],
        "title": "AuthorizationResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ProfileResponse": {
        "properties": {
          "coins": {
            "title": "Coins",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "purchases": {
            "title": "Purchases",
            "type": "integer"
          },
          "rank": {
            "title": "Rank",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "rank",
          "coins",
          "purchases"
        ],
        "title": "ProfileResponse",
        "type": "object"
      },
      "PurchaseRequest": {
        "properties": {
          "item": {
            "enum": [
              "diamond",
              "gold",
              "speed"
            ],
            "title": "Item",
            "type": "string"
          }
        },
        "required": [
          "item"
        ],
        "title": "PurchaseRequest",
        "type": "object"
      },
      "PurchaseResponse": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "profile": {
            "$ref": "#/components/schemas/ProfileResponse"
          },
          "reward": {
            "$ref": "#/components/schemas/Reward"
          }
        },
        "required": [
          "profile",
          "reward",
          "message"
        ],
        "title": "PurchaseResponse",
        "type": "object"
      },
      "RealtimeClientMessage": {
        "properties": {
          "request_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          },
          "type": {
            "enum": [
              "ping",
              "profile.refresh"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "request_id"
        ],
        "title": "RealtimeClientMessage",
        "type": "object"
      },
      "RealtimeServerMessage": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "player_id": {
            "title": "Player Id",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "type": {
            "enum": [
              "connected",
              "pong",
              "profile.invalidated",
              "error"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "player_id"
        ],
        "title": "RealtimeServerMessage",
        "type": "object"
      },
      "Reward": {
        "properties": {
          "amount": {
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Amount",
            "type": "integer"
          },
          "material": {
            "enum": [
              "DIAMOND",
              "GOLD_INGOT",
              "SUGAR"
            ],
            "title": "Material",
            "type": "string"
          }
        },
        "required": [
          "material",
          "amount"
        ],
        "title": "Reward",
        "type": "object"
      },
      "RoleResponse": {
        "properties": {
          "key": {
            "enum": [
              "member",
              "moderator",
              "admin"
            ],
            "title": "Key",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "permissions": {
            "items": {
              "enum": [
                "profile.read",
                "shop.purchase",
                "realtime.connect",
                "permissions.read",
                "permissions.manage"
              ],
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          }
        },
        "required": [
          "key",
          "name",
          "permissions"
        ],
        "title": "RoleResponse",
        "type": "object"
      },
      "SessionRequest": {
        "properties": {
          "player_id": {
            "maxLength": 36,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,35}$",
            "title": "Player Id",
            "type": "string"
          },
          "player_name": {
            "maxLength": 16,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_]{1,16}$",
            "title": "Player Name",
            "type": "string"
          }
        },
        "required": [
          "player_id",
          "player_name"
        ],
        "title": "SessionRequest",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "actor": {
            "$ref": "#/components/schemas/ActorResponse"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "actor"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SetPlayerRolesRequest": {
        "properties": {
          "roles": {
            "items": {
              "enum": [
                "member",
                "moderator",
                "admin"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "roles"
        ],
        "title": "SetPlayerRolesRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Graaly game API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
