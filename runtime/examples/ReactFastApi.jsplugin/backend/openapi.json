          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActorResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Resolve the authenticated player's current roles and permissions",
        "tags": [
          "authentication"
        ]
      }
    },
    "/v1/auth/session": {
      "post": {
        "operationId": "create_session_v1_auth_session_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-graaly-key",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Graaly-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Exchange a trusted game-server identity for a short player session",
        "tags": [
          "authentication"
        ]
      }
    },
