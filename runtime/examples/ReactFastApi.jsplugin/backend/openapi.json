    "/v1/realtime/validate": {
      "post": {
        "description": "HTTP contract endpoint keeps WebSocket payloads visible in OpenAPI.",
        "operationId": "validate_message_v1_realtime_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RealtimeClientMessage"
              }
            }
