{
  "name": "graaly-react-fastapi-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "uv run --project backend --frozen python backend/scripts/export_openapi.py && npm --prefix tools/openapi run generate",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/main.tsx --bundle --platform=neutral --format=esm --target=es2024 --define:process.env.NODE_ENV='\"production\"' --outfile=dist/main.mjs"
  },
  "dependencies": {
    "@graaly/react": "file:../../sdk/react",
    "@tanstack/react-query": "5.102.1",
    "graaly": "file:../../sdk/typescript",
    "react": "19.2.8",
    "react-reconciler": "0.33.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
